LatticeParameters
{
  * X and Y vectors define the simulation coordinate system relative to the
  * crystal orientation system.
    X = (0 0 -1)
    Y = (1 0  0)
}

* Device 2 (paper Fig. 5(b)), 2026-11-10, run n5: copy of sdevice_n4.par with one change (a0, below).
* Source/drain are ohmic on n+ GaN, so their tunnelling blocks are removed; the gate keeps its own.
BarrierTunneling "GateNLM"{
    mt	= 0.25,    1
    g	= 1,	1
}

ThermionicEmission {
	Formula= 1
}

* n4: the relaxed layer is the 0.8 um Al0.04GaN "buffer" [Ambacher et al., JAP 85, 3222, 1999];
* the GaN channel and the layers above are left strained (n2/n3 had "channel" relaxed instead).
Region= "buffer" {
  Piezoelectric_polarization {
        relax = 1
  }
}

* n5: layers grown on the relaxed buffer are strained to its lattice, not to GaN.
* a0 = a(Al0.04GaN) = 3.189 - 0.04*(3.189 - 3.112) = 3.1859 A [CALC, Vegard; a(0), a(1) from AlGaN.par].
* Default a0 = 3.189 A (GaN) [Sentaurus MaterialDB T-2022.03, GaN.par, AlGaN.par].
Region= "channel" {
  Piezoelectric_polarization {
        a0 = 3.1859
  }
}
Region= "graded" {
  Piezoelectric_polarization {
        a0 = 3.1859
  }
}
Region= "barrier" {
  Piezoelectric_polarization {
        a0 = 3.1859
  }
}
Region= "nplus_source" {
  Piezoelectric_polarization {
        a0 = 3.1859
  }
}
Region= "nplus_drain" {
  Piezoelectric_polarization {
        a0 = 3.1859
  }
}
